{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-social-link" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-social-link" class="form-horizontal">
          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-general"   data-toggle="tab">{{ tab_general }}</a></li>
            <li><a href="#tab-locations" data-toggle="tab">{{ tab_locations }}</a></li>
          </ul>
          <div class="tab-content">

            {# ============ GENERAL ============ #}
            <div class="tab-pane active" id="tab-general">

              <div class="form-group required">
                <label class="col-sm-2 control-label" for="input-platform-key"><span data-toggle="tooltip" title="{{ help_platform_key }}">{{ entry_platform_key }}</span></label>
                <div class="col-sm-10">
                  <select name="platform_key" id="input-platform-key" class="form-control">
                    <option value=""></option>
                    {% for p in platforms %}
                    {% if p.key == platform_key %}
                    <option value="{{ p.key }}" selected="selected">{{ p.label }}</option>
                    {% else %}
                    <option value="{{ p.key }}">{{ p.label }}</option>
                    {% endif %}
                    {% endfor %}
                  </select>
                  {% if error_platform_key %}<div class="text-danger">{{ error_platform_key }}</div>{% endif %}
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-display-name"><span data-toggle="tooltip" title="{{ help_display_name }}">{{ entry_display_name }}</span></label>
                <div class="col-sm-10">
                  <input type="text" name="display_name" value="{{ display_name }}" placeholder="(defaults to platform name)" id="input-display-name" class="form-control" maxlength="80" />
                  {% if error_display_name %}<div class="text-danger">{{ error_display_name }}</div>{% endif %}
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-url"><span data-toggle="tooltip" title="{{ help_url }}">{{ entry_url }}</span></label>
                <div class="col-sm-10">
                  <input type="text" name="url" value="{{ url }}" placeholder="https://t.me/yourchannel  —  or for WeChat: yourwechatid" id="input-url" class="form-control" maxlength="500" />
                  {% if error_url %}<div class="text-danger">{{ error_url }}</div>{% endif %}
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label"><span data-toggle="tooltip" title="{{ help_qr_image }}">{{ entry_qr_image }}</span></label>
                <div class="col-sm-10">
                  <a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{{ thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
                  <input type="hidden" name="qr_image_url" value="{{ qr_image_url }}" id="input-image" />
                  {% if error_qr_image %}<div class="text-danger">{{ error_qr_image }}</div>{% endif %}
                  <div class="help-block">{{ text_qr_optional }}</div>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <select name="status" id="input-status" class="form-control">
                    {% if status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-sort-order"><span data-toggle="tooltip" title="{{ help_sort_order }}">{{ entry_sort_order }}</span></label>
                <div class="col-sm-10">
                  <input type="text" name="sort_order" value="{{ sort_order }}" placeholder="0" id="input-sort-order" class="form-control" />
                </div>
              </div>

            </div>{# /tab-general #}

            {# ============ LOCATIONS ============ #}
            <div class="tab-pane" id="tab-locations">
              <p class="help-block" style="margin-bottom: 20px;">
                {{ entry_locations }} —
                <em>tick the boxes for each location where this platform's icon should appear on the public site. Even with all 8 ticked, the icon stays hidden until "Status" on the General tab is set to Enabled.</em>
              </p>

              {% set loc_fields = [
                ['show_footer',        location_footer,        show_footer],
                ['show_header_top',    location_header_top,    show_header_top],
                ['show_product_page',  location_product_page,  show_product_page],
                ['show_cart_page',     location_cart_page,     show_cart_page],
                ['show_checkout',      location_checkout,      show_checkout],
                ['show_order_success', location_order_success, show_order_success],
                ['show_contact_about', location_contact_about, show_contact_about],
                ['show_mobile_drawer', location_mobile_drawer, show_mobile_drawer]
              ] %}

              {% for f in loc_fields %}
              <div class="form-group">
                <label class="col-sm-4 control-label" for="input-{{ f[0]|replace({'_':'-'}) }}">{{ f[1] }}</label>
                <div class="col-sm-8">
                  <label class="radio-inline">
                    {% if f[2] %}
                    <input type="radio" name="{{ f[0] }}" value="1" id="input-{{ f[0]|replace({'_':'-'}) }}" checked="checked" />
                    {% else %}
                    <input type="radio" name="{{ f[0] }}" value="1" id="input-{{ f[0]|replace({'_':'-'}) }}" />
                    {% endif %}
                    {{ text_enabled }}
                  </label>
                  <label class="radio-inline">
                    {% if f[2] %}
                    <input type="radio" name="{{ f[0] }}" value="0" />
                    {% else %}
                    <input type="radio" name="{{ f[0] }}" value="0" checked="checked" />
                    {% endif %}
                    {{ text_disabled }}
                  </label>
                </div>
              </div>
              {% endfor %}

            </div>{# /tab-locations #}

          </div>{# /tab-content #}
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
