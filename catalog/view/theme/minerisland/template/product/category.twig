{{ header }}

{% if breadcrumbs is defined and breadcrumbs|length > 0 %}
{# ── B6 BreadcrumbList JSON-LD (Session 15, additive; v2) ── #}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {%- for breadcrumb in breadcrumbs %}
    {%- set crumb_name = breadcrumb.text|striptags|trim %}
    {%- if crumb_name is empty %}{% set crumb_name = 'Home' %}{% endif %}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "name": {{ crumb_name|json_encode|raw }},
      "item": {{ breadcrumb.href|replace({'&amp;': '&'})|json_encode|raw }}
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{# ── end B6 ── #}
{% endif %}


<div class="mi-category-page" id="product-category">
  <div class="mi-container">

    {# ── Breadcrumb ──────────────────────────────────── #}
    <nav class="mi-breadcrumb" aria-label="Breadcrumb">
      <ol>
        {% for breadcrumb in breadcrumbs %}
          <li>
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
            {% if not loop.last %}<span aria-hidden="true">›</span>{% endif %}
          </li>
        {% endfor %}
      </ol>
    </nav>

    {# ── Hero / intro ────────────────────────────────── #}
    <header class="mi-category-hero">
      <h1 class="mi-category-hero__title">{{ heading_title }}</h1>
      {% if description %}
        <div class="mi-prose mi-category-hero__intro">{{ description }}</div>
      {% endif %}
    </header>

    {# ── Subcategory tiles (only if this category has children) ── #}
    {% if categories %}
      <section class="mi-subcat" aria-label="Subcategories">
        <h2 class="mi-subcat__title">Browse by tier</h2>
        <div class="mi-subcat__grid">
          {% for category in categories %}
            <a href="{{ category.href }}" class="mi-subcat__tile">
              {% if category.thumb %}
                <span class="mi-subcat__icon"><img src="{{ category.thumb }}" alt=""></span>
              {% else %}
                <span class="mi-subcat__icon mi-subcat__icon--placeholder" aria-hidden="true">⛏</span>
              {% endif %}
              <span class="mi-subcat__name">{{ category.name }}</span>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {# ── Toolbar (sort + limit + result count) ─────── #}
    {% if products %}
      <div class="mi-toolbar">
        <div class="mi-toolbar__results">
          {{ results }}
        </div>
        <div class="mi-toolbar__controls">
          <div class="mi-toolbar__field">
            <label for="input-sort">Sort</label>
            <select id="input-sort" class="mi-select" onchange="location = this.value;">
              {% for s in sorts %}
                <option value="{{ s.href }}"{% if s.value == sort ~ '-' ~ order %} selected{% endif %}>{{ s.text }}</option>
              {% endfor %}
            </select>
          </div>
          <div class="mi-toolbar__field">
            <label for="input-limit">Show</label>
            <select id="input-limit" class="mi-select" onchange="location = this.value;">
              {% for l in limits %}
                <option value="{{ l.href }}"{% if l.value == limit %} selected{% endif %}>{{ l.text }}</option>
              {% endfor %}
            </select>
          </div>
        </div>
      </div>

      {# ── Product grid ──────────────────────────────── #}
      <div class="mi-product-grid">
        {% for product in products %}
          <article class="mi-product-card">
            <a class="mi-product-card__image" href="{{ product.href }}" aria-label="{{ product.name }}">
              {% if product.thumb %}
                <img src="{{ product.thumb }}" alt="{{ product.name }}" loading="lazy">
              {% else %}
                <span class="mi-product-card__placeholder" aria-hidden="true">⛏</span>
              {% endif %}
              {% if product.special %}
                <span class="mi-product-card__badge">Sale</span>
              {% endif %}
            </a>
            <div class="mi-product-card__body">
              <h3 class="mi-product-card__title">
                <a href="{{ product.href }}">{{ product.name }}</a>
              </h3>
              {% if product.price %}
                <div class="mi-product-card__price">
                  {% if product.special %}
                    <span class="mi-product-card__price-new">{{ product.special }}</span>
                    <span class="mi-product-card__price-old">{{ product.price }}</span>
                  {% else %}
                    <span class="mi-product-card__price-new">{{ product.price }}</span>
                  {% endif %}
                </div>
                <p class="mi-product-card__btc">Pay in BTC, save 3%</p>
              {% endif %}
              <div class="mi-product-card__actions">
                <button type="button"
                        class="mi-btn mi-btn--primary mi-btn--sm mi-product-card__cart"
                        data-mi-card-add="{{ product.product_id }}"
                        onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"
                        aria-label="Add {{ product.name }} to cart">
                  <span class="mi-product-card__cart-label">Add to cart</span>
                  <span class="mi-product-card__cart-count" data-mi-card-count="0" hidden>0</span>
                </button>
                <a href="{{ product.href }}" class="mi-btn mi-btn--ghost mi-btn--sm">Details</a>
              </div>
            </div>
          </article>
        {% endfor %}
      </div>

      {# ── Pagination ───────────────────────────────── #}
      <div class="mi-pagination">
        <div class="mi-pagination__nav">{{ pagination }}</div>
        <div class="mi-pagination__results">{{ results }}</div>
      </div>
    {% endif %}

    {# ── Empty state ─────────────────────────────────── #}
    {% if not categories and not products %}
      <div class="mi-empty">
        <p>{{ text_empty }}</p>
        <a href="{{ continue }}" class="mi-btn mi-btn--primary">{{ button_continue }}</a>
      </div>
    {% endif %}

    {{ content_bottom }}
  </div>
</div>

{# ═══ S19 ANALYTICS: GA4 view_item_list ═════════════════════════════════════
   One push per category page with every product card shown. Prices are the
   formatted display strings, cleaned to numbers client-side.
   ══════════════════════════════════════════════════════════════════════════ #}
{% if products %}
<script>
(function(){
  window.dataLayer = window.dataLayer || [];
  function num(s){ return parseFloat(String(s).replace(/[^0-9.]/g, '')) || 0; }
  var items = [
    {%- for product in products %}
    {item_id: '{{ product.product_id }}', item_name: {{ product.name|json_encode|raw }}, index: {{ loop.index0 }}, price: num({{ (product.special ? product.special : product.price)|json_encode|raw }})}{% if not loop.last %},{% endif %}
    {%- endfor %}
  ];
  window.dataLayer.push({ecommerce: null});
  window.dataLayer.push({
    event: 'view_item_list',
    ecommerce: {
      item_list_name: {{ heading_title|json_encode|raw }},
      items: items
    }
  });
})();
</script>
{% endif %}

{{ footer }}
