                <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                <path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/>
              </svg>
              Add to cart
            </button>
          </div>

          {% set wa_text = "Hi, I'm interested in " ~ heading_title ~ " (#" ~ product_id ~ "). Can you confirm stock and shipping to my location?" %}
          <a href="https://wa.me/16173008178?text={{ wa_text|url_encode }}"
             class="mi-btn mi-btn--whatsapp mi-btn--lg mi-buybox__whatsapp"
             target="_blank" rel="noopener">
