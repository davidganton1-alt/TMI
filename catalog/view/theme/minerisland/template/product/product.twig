{# ── Image lightbox ──────────────────────────────────── #}
<div class="mi-lightbox" id="mi-lightbox" hidden>
  <button type="button" class="mi-lightbox__close" aria-label="Close">×</button>
  <img src="" alt="" id="mi-lightbox-img">
</div>

<script>
// ════════════════════════════════════════════════════════════════
// Phase 4, product page JS
// ════════════════════════════════════════════════════════════════
(function() {
  'use strict';

  const productId = {{ product_id }};

  // ── 1. Gallery thumb swap + lightbox ──────────────────
  const mainImg = document.getElementById('mi-gallery-img');
  document.querySelectorAll('.mi-gallery__thumb').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.mi-gallery__thumb').forEach(b => b.classList.remove('mi-gallery__thumb--active'));
      btn.classList.add('mi-gallery__thumb--active');
      if (mainImg) {
        mainImg.src = btn.dataset.img;
        mainImg.dataset.full = btn.dataset.full;
      }
    });
  });

  const lightbox = document.getElementById('mi-lightbox');
  const lightboxImg = document.getElementById('mi-lightbox-img');
  const zoomBtn = document.getElementById('mi-gallery-zoom');
  function openLightbox() {
    if (!mainImg || !lightbox) return;
    lightboxImg.src = mainImg.dataset.full || mainImg.src;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    lightbox.hidden = true;
    document.body.style.overflow = '';
  }
  if (zoomBtn) zoomBtn.addEventListener('click', openLightbox);
  if (mainImg) mainImg.addEventListener('click', openLightbox);
  if (lightbox) {
    lightbox.addEventListener('click', e => {
      if (e.target === lightbox || e.target.classList.contains('mi-lightbox__close')) closeLightbox();
    });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !lightbox.hidden) closeLightbox();
    });
  }

  // ── 2. Tabs ───────────────────────────────────────────
  document.querySelectorAll('.mi-tabs__tab').forEach(tab => {
    tab.addEventListener('click', () => {
      const key = tab.dataset.tab;
      document.querySelectorAll('.mi-tabs__tab').forEach(t => t.classList.remove('mi-tabs__tab--active'));
      document.querySelectorAll('.mi-tabs__panel').forEach(p => p.classList.remove('mi-tabs__panel--active'));
      tab.classList.add('mi-tabs__tab--active');
      const panel = document.querySelector('.mi-tabs__panel[data-panel="' + key + '"]');
      if (panel) panel.classList.add('mi-tabs__panel--active');
    });
  });

  // ── 3. Quantity stepper ──────────────────────────────
  const qtyInput = document.getElementById('input-quantity');
  document.querySelectorAll('.mi-qty__btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (!qtyInput) return;
      const step = parseInt(btn.dataset.step, 10);
      const current = parseInt(qtyInput.value, 10) || 1;
      const next = Math.max(1, current + step);
      qtyInput.value = next;
    });
  });

  // ── 4. Parse description for specs ───────────────────
  // SPEC-PARSE-v2: read values from the "Quick specs" list items, NOT from a
  // flat scan of the whole description. The old version matched the FIRST
  // occurrence of "Algorithm"/"Cooling" anywhere in the prose, so sentences
  // like "built for the SHA-256 algorithm and..." or "Cooling changes the
  // economics..." fed junk words ("and", "changes", "for", "system",
  // "rewards") into the spec strip. The list items are structured as
  // "Label: value" (value sometimes wrapped in <strong>), so reading each
  // <li> in isolation removes all prose interference.
  function parseSpecsFromDescription() {
    const desc = document.getElementById('mi-product-description');
    if (!desc) return {};
    const text = desc.textContent || '';
    const specs = {};

    // Build a label->value map from the spec list items only.
    // Each spec <li> reads like "Algorithm: SHA-256" or "Cooling: Air-cooled".
    const liMap = {};
    desc.querySelectorAll('li').forEach(function (li) {
      const t = (li.textContent || '').trim();
      const m = t.match(/^([A-Za-z ]+?)\s*:\s*(.+)$/);
      if (m) {
        const key = m[1].trim().toLowerCase();
        const val = m[2].trim();
        if (!(key in liMap)) liMap[key] = val;  // first spec-list hit wins
      }
    });

    // Hashrate: prefer the spec-list value, parse number + unit from it.
    const hashSrc = liMap['hashrate'] || text;
    const hash = hashSrc.match(/([\d,.]+)\s*(TH\/s|GH\/s|MH\/s|kH\/s|H\/s|kS\/s|MS\/s|GS\/s|PH\/s|kSol\/s|Sol\/s)/i);
    if (hash) {
      specs.hashrate = parseFloat(hash[1].replace(/,/g, ''));
      specs.hashrateUnit = hash[2];
    }
    // Efficiency: prefer spec-list value.
    const effSrc = liMap['efficiency'] || text;
    const eff = effSrc.match(/([\d.]+)\s*(J\/TH|J\/GH|J\/MH|J\/Gh|J\/Th)/i);
    if (eff) {
      specs.efficiency = parseFloat(eff[1]);
      specs.efficiencyUnit = eff[2];
    }
    // Algorithm: spec-list only (no prose fallback, to avoid junk matches).
    if (liMap['algorithm']) specs.algorithm = liMap['algorithm'].replace(/\.$/, '').trim();
    // Cooling: spec-list only; keep the full descriptor (e.g. "Air-cooled, dual-fan").
    if (liMap['cooling']) specs.cooling = liMap['cooling'].replace(/\.$/, '').trim();
    // Coin: spec-list only.
    if (liMap['coin']) specs.coin = liMap['coin'].replace(/\.$/, '').trim();

    // Derive power (W) = hashrate × efficiency (when both are TH/s and J/TH)
    if (specs.hashrate && specs.efficiency &&
        /TH\/s/i.test(specs.hashrateUnit || '') &&
        /J\/TH/i.test(specs.efficiencyUnit || '')) {
      specs.powerW = Math.round(specs.hashrate * specs.efficiency);
    }
    return specs;
  }

  const specs = parseSpecsFromDescription();

  // ── 5. Render spec strip ─────────────────────────────
  const stripEl = document.getElementById('mi-spec-strip');
  if (stripEl) {
    const items = [];
    if (specs.hashrate) items.push(['Hashrate', specs.hashrate.toLocaleString() + ' ' + specs.hashrateUnit]);
    if (specs.efficiency) items.push(['Efficiency', specs.efficiency + ' ' + specs.efficiencyUnit]);
    if (specs.powerW) items.push(['Power', specs.powerW.toLocaleString() + ' W']);
    if (specs.algorithm) items.push(['Algorithm', specs.algorithm]);
    if (specs.cooling) items.push(['Cooling', specs.cooling]);
    items.forEach(([k, v]) => {
      const dt = document.createElement('dt'); dt.textContent = k;
      const dd = document.createElement('dd'); dd.textContent = v;
      stripEl.appendChild(dt); stripEl.appendChild(dd);
    });
  }

  // ── 6. Tier badge (Enterprise / Standard / Entry) ───
  // Based on J/TH efficiency, matches category-page thresholds.
  const tierEl = document.getElementById('mi-tier-badge');
  if (tierEl && specs.efficiency && /J\/TH/i.test(specs.efficiencyUnit || '')) {
    let tier, label;
    if (specs.efficiency <= 14) { tier = 'enterprise'; label = 'Enterprise tier · flagship efficiency'; }
    else if (specs.efficiency <= 25) { tier = 'standard'; label = 'Standard tier · best-value ROI'; }
    else { tier = 'entry'; label = 'Entry tier · proven older silicon'; }
    tierEl.className = 'mi-buybox__tier mi-buybox__tier--' + tier;
    tierEl.textContent = label;
    tierEl.hidden = false;
  }

  // ── 7. Savings % ─────────────────────────────────────
  // Pulls current/old price out of the rendered DOM and computes %.
  (function() {
    const newEl = document.querySelector('.mi-buybox__price-new');
    const oldEl = document.querySelector('.mi-buybox__price-old');
    const savEl = document.getElementById('mi-savings');
    if (!newEl || !oldEl || !savEl) return;
    const toNum = s => parseFloat(String(s).replace(/[^\d.]/g, ''));
    const n = toNum(newEl.textContent);
    const o = toNum(oldEl.textContent);
    if (n && o && o > n) {
      const pct = Math.round((1 - n / o) * 100);
      savEl.textContent = '−' + pct + '%';
    }
  })();

  // ── 8. ROI calculator (BTC / LTC / KAS / XMR / ZEC, + DOGE merge bonus) ─
  //
  // DATA MODEL
  //   We use the canonical network-share formula for every algorithm:
  //     daily_coins = (your_Hs / network_Hs) × block_reward × blocks_per_day
  //   This is the same math every mining calculator runs. Three live inputs:
  //     - network_Hs       (refreshed hourly via /index.php?route=extension/module/mining_data)
  //     - block_reward     (protocol constant, only changes at halvings)
  //     - blocks_per_day   (protocol constant)
  //   And one variable input:
  //     - coin price       (from your existing Phase 3 ticker cache, 60s refresh)
  //
  // REFRESH STRATEGY
  //   Page renders immediately with baseline numbers. After paint, we fetch
  //   mi_mining_data.json (cached server-side hourly). If it lands within
  //   200ms (typical, same domain), the inputs silently swap to live values.
  //   If the fetch fails, baselines stay, no console error, no broken UI.
  //
  // NO FABRICATED VALUES
  //   Every constant below traces to a real source:
  //     - BTC : 3.125 BTC/block (April 2024 halving, public consensus)
  //     - LTC : 6.25  LTC/block (pre-Aug 2027 halving)
  //     - KAS : 55    KAS/block (drops July 10 2026, surfaced in note)
  //     - XMR : 0.6   XMR/block (tail emission)
  //     - ZEC : 1.5625 ZEC/block (post-Nov 2024 halving)
  //     - DOGE: 10000 DOGE/block (always-on)
  //   Baseline network_Hs values match minerstat snapshot from May 17, 2026.
  //
  const ROI_CONFIG = {
    'SHA-256': {
      coin: 'BTC', coinName: 'Bitcoin', tickerKey: 'bitcoin',
      unit: 'TH/s', coinDecimals: 8,
      networkNote: 'Network ~1 ZH/s · 3.125 BTC/block · 144 blocks/day'
    },
    'Scrypt': {
      coin: 'LTC', coinName: 'Litecoin', tickerKey: 'litecoin',
      unit: 'GH/s', coinDecimals: 6,
      // Scrypt ASICs merge-mine DOGE at full hashrate, no extra power.
      // Both coins use the same network_Hs (your unit) but DIFFERENT
      // network hashrates (LTC ~2.85 PH/s vs DOGE ~2.99 PH/s) since
      // not every pool merges.
      mergeMineCoin: 'DOGE', mergeMineTickerKey: 'dogecoin',
      networkNote: 'LTC + DOGE merge-mined at full hashrate, no extra power'
    },
    'kHeavyHash': {
      coin: 'KAS', coinName: 'Kaspa', tickerKey: 'kaspa',
      unit: 'TH/s', coinDecimals: 2,
      networkNote: 'KAS emission cliff July 10, 2026. Daily issuance drops about 90% after that date.'
    },
    'RandomX': {
      coin: 'XMR', coinName: 'Monero', tickerKey: 'monero',
      unit: 'H/s', coinDecimals: 8,
      networkNote: 'Monero tail emission · 0.6 XMR/block forever'
    },
    'Equihash': {
      coin: 'ZEC', coinName: 'Zcash', tickerKey: 'zcash',
      unit: 'kSol/s', coinDecimals: 6,
      networkNote: 'Equihash · 1.5625 ZEC/block post Nov 2024 halving'
    }
  };

  // Mutable network parameters (filled from baseline first, then overwritten
  // by live fetch). Block rewards + blocks_per_day are protocol constants.
  // network_Hs is the only field that drifts daily.
  const NETWORK_PARAMS = {
    'BTC':  { network_hs: 1.02e21,  block_reward: 3.125,  blocks_per_day: 144,   source: 'baseline' },
    'LTC':  { network_hs: 2.85e15,  block_reward: 6.25,   blocks_per_day: 576,   source: 'baseline' },
    'KAS':  { network_hs: 4.15e17,  block_reward: 55,     blocks_per_day: 86400, source: 'baseline' },
    'XMR':  { network_hs: 6.5e9,    block_reward: 0.6,    blocks_per_day: 720,   source: 'baseline' },
    'ZEC':  { network_hs: 1.507e16, block_reward: 1.5625, blocks_per_day: 1152,  source: 'baseline' },
    'DOGE': { network_hs: 2.99e15,  block_reward: 10000,  blocks_per_day: 1440,  source: 'baseline' }
  };

  // Normalize the algorithm string parsed from the description so we can
  // look it up in ROI_CONFIG (case-insensitive, dash-insensitive).
  function normalizeAlgo(s) {
    if (!s) return null;
    const v = s.replace(/-/g, '').toLowerCase();
    if (v === 'sha256') return 'SHA-256';
    if (v === 'scrypt') return 'Scrypt';
    if (v === 'kheavyhash' || v === 'khash') return 'kHeavyHash';
    if (v === 'randomx') return 'RandomX';
    if (v === 'equihash') return 'Equihash';
    return null;
  }

  // Convert a parsed hashrate (value + unit) into the algo's canonical unit.
  // Returns the number in canonical units, or null if unit conversion fails.
  function convertToCanonical(value, fromUnit, toUnit) {
    if (!value || !fromUnit || !toUnit) return null;
    // Strip the per-second piece and any algo-specific suffix (Sol, S, etc.)
    // and reduce to the SI prefix only.
    const prefixOf = (u) => {
      const m = u.match(/^([kMGTPE])?/i);
      if (!m || !m[1]) return 0;
      return {k:3, K:3, M:6, G:9, T:12, P:15, E:18}[m[1]] || 0;
    };
    const factor = Math.pow(10, prefixOf(fromUnit) - prefixOf(toUnit));
    return value * factor;
  }

  function formatCoinAmount(n, decimals) {
    if (n === 0) return '0';
    if (Math.abs(n) >= 100) return n.toFixed(2);
    if (Math.abs(n) >= 1) return n.toFixed(Math.min(4, decimals));
    if (Math.abs(n) >= 0.0001) return n.toFixed(Math.min(6, decimals));
    return n.toExponential(2);
  }

  function formatUSD(n) {
    if (!isFinite(n)) return '-';
    const sign = n < 0 ? '−' : '';
    const abs = Math.abs(n);
    if (abs < 0.01 && abs > 0) return sign + '$' + abs.toFixed(4);
    return sign + '$' + abs.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  const roiEl = document.getElementById('mi-roi');
  const algoKey = normalizeAlgo(specs.algorithm);
  const config = algoKey ? ROI_CONFIG[algoKey] : null;

  if (roiEl && config && specs.hashrate && specs.hashrateUnit) {
    // Your unit's hashrate in raw H/s, used directly in the network-share formula.
    // Works for every algorithm because we just divide your_Hs / network_Hs.
    const yourHs = convertToCanonical(specs.hashrate, specs.hashrateUnit, 'H/s');

    // Need power for the cost side. Derived from hashrate × efficiency in
    // the parser for ASICs. CPU rigs (RandomX) often omit power, fallback about 8W/kH/s.
    let powerW = specs.powerW;
    if (!powerW && algoKey === 'RandomX' && specs.hashrate) {
      const khs = convertToCanonical(specs.hashrate, specs.hashrateUnit, 'kH/s');
      powerW = khs ? Math.round(khs * 8) : 100;
    }

    if (yourHs && yourHs > 0 && powerW && powerW > 0) {
      roiEl.hidden = false;

      // Labels
      document.getElementById('mi-roi-coin-name').textContent = config.coinName;
      document.getElementById('mi-roi-coinprice-label').textContent = config.coin;
      document.getElementById('mi-roi-network-note').textContent = config.networkNote || '';

      const priceInput  = document.getElementById('mi-roi-coinprice');
      const kwhInput    = document.getElementById('mi-roi-kwh');
      const feeInput    = document.getElementById('mi-roi-fee');
      const unitPriceIn = document.getElementById('mi-roi-price');
      const minedEl     = document.getElementById('mi-roi-mined');
      const minedMetaEl = document.getElementById('mi-roi-mined-meta');
      const revEl       = document.getElementById('mi-roi-revenue');
      const revMetaEl   = document.getElementById('mi-roi-revenue-meta');
      const powerEl     = document.getElementById('mi-roi-power');
      const powerMetaEl = document.getElementById('mi-roi-power-meta');
      const dailyEl     = document.getElementById('mi-roi-daily');
      const dailyMetaEl = document.getElementById('mi-roi-daily-meta');
      const monthlyEl   = document.getElementById('mi-roi-monthly');
      const breakevenEl = document.getElementById('mi-roi-breakeven');
      const priceSrcEl  = document.getElementById('mi-roi-coinprice-source');

      // Read live coin price from Phase 3 ticker cache
      function readTickerPrice(tickerKey) {
        try {
          const raw = localStorage.getItem('mi-ticker-cache-v1');
          if (!raw) return null;
          const parsed = JSON.parse(raw);
          if (!parsed || !parsed.data || !parsed.data[tickerKey]) return null;
          const p = parsed.data[tickerKey].usd;
          return (typeof p === 'number' && p > 0) ? p : null;
        } catch (e) { return null; }
      }

      const livePrice = readTickerPrice(config.tickerKey);
      if (livePrice) {
        priceInput.value = livePrice < 1 ? livePrice.toFixed(6) : livePrice.toFixed(2);
        priceSrcEl.textContent = 'Live ' + config.coin + ' price · $' +
          (livePrice < 1 ? livePrice.toFixed(6) : livePrice.toFixed(2));
      } else {
        const fallbacks = { bitcoin: 80000, litecoin: 90, kaspa: 0.036, monero: 350, zcash: 540, dogecoin: 0.20 };
        priceInput.value = fallbacks[config.tickerKey] || 1;
        priceSrcEl.textContent = 'May 2026 baseline, edit if you have a fresher price';
      }

      // Merge-mine coin price (DOGE for LTC)
      let mergePrice = 0;
      if (config.mergeMineTickerKey) {
        mergePrice = readTickerPrice(config.mergeMineTickerKey) || 0.20;
      }

      // Auto-fill unit price from DOM (price displayed in the buybox)
      const priceCurEl = document.getElementById('mi-price-current');
      if (priceCurEl) {
        const p = parseFloat(priceCurEl.textContent.replace(/[^\d.]/g, ''));
        if (p) unitPriceIn.value = Math.round(p);
      }

      function recalc() {
        const coinPrice = parseFloat(priceInput.value) || 0;
        const kwh = parseFloat(kwhInput.value) || 0;
        const fee = (parseFloat(feeInput.value) || 0) / 100;
        const unitPrice = parseFloat(unitPriceIn.value) || 0;

        // ── Network-share formula (universal across all algos) ──────────
        //   daily_coins = (your_Hs / network_Hs) × block_reward × blocks_per_day
        const primaryNet = NETWORK_PARAMS[config.coin];
        const share = yourHs / primaryNet.network_hs;
        const primaryCoinsPerDay = share * primaryNet.block_reward * primaryNet.blocks_per_day;

        // Merge-mine bonus: same yourHs, different network params
        let mergeCoinsPerDay = 0;
        if (config.mergeMineCoin) {
          const mergeNet = NETWORK_PARAMS[config.mergeMineCoin];
          if (mergeNet) {
            const mergeShare = yourHs / mergeNet.network_hs;
            mergeCoinsPerDay = mergeShare * mergeNet.block_reward * mergeNet.blocks_per_day;
          }
        }

        const primaryRevenue = primaryCoinsPerDay * coinPrice * (1 - fee);
        const mergeRevenue   = mergeCoinsPerDay  * mergePrice * (1 - fee);
        const grossRevenue   = primaryRevenue + mergeRevenue;

        const dailyPowerCost = (powerW / 1000) * 24 * kwh;
        const dailyProfit    = grossRevenue - dailyPowerCost;
        const monthlyProfit  = dailyProfit * 30;

        // Row 1: daily coins
        minedEl.textContent = formatCoinAmount(primaryCoinsPerDay, config.coinDecimals) + ' ' + config.coin;
        if (mergeCoinsPerDay > 0) {
          minedMetaEl.textContent = '+ ' + formatCoinAmount(mergeCoinsPerDay, 2) + ' ' + config.mergeMineCoin + ' (merge-mined, same hashrate)';
        } else {
          minedMetaEl.textContent = 'at ' + specs.hashrate.toLocaleString() + ' ' + specs.hashrateUnit + ' · ' +
            (primaryNet.source === 'baseline' ? 'May 2026 baseline difficulty' : 'live difficulty from ' + primaryNet.source);
        }

        // Row 2: daily revenue
        revEl.textContent = formatUSD(grossRevenue);
        if (mergeRevenue > 0) {
          revMetaEl.textContent = formatUSD(primaryRevenue) + ' ' + config.coin + ' + ' + formatUSD(mergeRevenue) + ' ' + config.mergeMineCoin;
        } else {
          revMetaEl.textContent = 'after ' + (parseFloat(feeInput.value) || 0) + '% pool fee';
        }

        // Row 3: daily power cost
        powerEl.textContent = '−' + formatUSD(dailyPowerCost).replace('−', '');
        powerMetaEl.textContent = powerW.toLocaleString() + ' W × 24h × $' + kwh.toFixed(3);

        // Row 4: daily profit (accent)
        dailyEl.textContent = formatUSD(dailyProfit);
        dailyMetaEl.textContent = (dailyProfit >= 0 ? 'Net positive at these inputs' : 'Net negative at these inputs');
        monthlyEl.textContent = formatUSD(monthlyProfit);

        if (dailyProfit > 0 && unitPrice > 0) {
          breakevenEl.textContent = Math.ceil(unitPrice / dailyProfit).toLocaleString() + ' days';
        } else if (dailyProfit <= 0) {
          breakevenEl.textContent = 'Never (at current inputs)';
        } else {
          breakevenEl.textContent = '-';
        }

        dailyEl.className   = 'mi-roi__out-value ' + (dailyProfit   >= 0 ? 'mi-roi__out-value--pos' : 'mi-roi__out-value--neg');
        monthlyEl.className = 'mi-roi__out-value ' + (monthlyProfit >= 0 ? 'mi-roi__out-value--pos' : 'mi-roi__out-value--neg');
      }

      [priceInput, kwhInput, feeInput, unitPriceIn].forEach(el => {
        if (el) el.addEventListener('input', recalc);
      });
      recalc();

      // ── Live network-data refresh ───────────────────────────────────
      // Fires AFTER initial paint. Updates NETWORK_PARAMS in place and
      // triggers a recalc. Fails silently, baseline values are already showing.
      // Cache-Control: 5-minute browser cache means repeat navigations
      // within 5 min don't even hit the network.
      function refreshNetworkData() {
        // Use the idle callback if available so we don't compete with
        // critical scripts (cart, lightbox, ROI initial paint).
        const fire = () => {
          fetch('index.php?route=extension/module/mining_data', {
            method: 'GET',
            credentials: 'same-origin',
            cache: 'default'
          })
          .then(r => r.ok ? r.json() : null)
          .then(data => {
            if (!data || typeof data !== 'object') return;
            let updated = false;
            ['BTC','LTC','KAS','XMR','ZEC','DOGE'].forEach(c => {
              if (data[c] && data[c].network_hs > 0) {
                NETWORK_PARAMS[c].network_hs = data[c].network_hs;
                if (data[c].block_reward > 0)   NETWORK_PARAMS[c].block_reward = data[c].block_reward;
                if (data[c].blocks_per_day > 0) NETWORK_PARAMS[c].blocks_per_day = data[c].blocks_per_day;
                NETWORK_PARAMS[c].source = data[c].source || 'live';
                updated = true;
              }
            });
            if (updated) recalc();
          })
          .catch(() => { /* silent, baseline stays visible */ });
        };
        if ('requestIdleCallback' in window) {
          requestIdleCallback(fire, { timeout: 2000 });
        } else {
          setTimeout(fire, 200);
        }
      }
      refreshNetworkData();
    }
  }

  // ── 9. Sticky mobile bottom bar ─────────────────────
  const stickyBar = document.getElementById('mi-sticky-bar');
  const buyboxAdd = document.getElementById('button-cart');
  const stickyAdd = document.getElementById('mi-sticky-add');
  if (stickyBar && buyboxAdd) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        // Show sticky when buybox add-to-cart goes out of view, on mobile
        if (!entry.isIntersecting) {
          stickyBar.classList.add('mi-sticky-bar--show');
        } else {
          stickyBar.classList.remove('mi-sticky-bar--show');
        }
      });
    }, { threshold: 0 });
    io.observe(buyboxAdd);

    if (stickyAdd) {
      stickyAdd.addEventListener('click', () => buyboxAdd.click());
    }
  }

  // ── 10. Add to cart (OpenCart standard) ─────────────
  $('#button-cart').on('click', function() {
    var formData = $('#product input[type="text"], #product input[type="hidden"], #product input[type="radio"]:checked, #product input[type="checkbox"]:checked, #product select, #product textarea');
    $.ajax({
      url: 'index.php?route=checkout/cart/add',
      type: 'post',
      data: formData,
      dataType: 'json',
      beforeSend: function() {
        $('#button-cart').prop('disabled', true).text('Adding…');
      },
      complete: function() {
        $('#button-cart').prop('disabled', false).html(
          '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg> Add to cart'
        );
      },
      success: function(json) {
        $('.alert-dismissible, .text-danger').remove();
        $('.mi-form-group').removeClass('mi-form-group--has-error');
        if (json['error']) {
          if (json['error']['option']) {
            for (var i in json['error']['option']) {
              var element = $('#input-option' + i.replace('_', '-'));
              element.after('<div class="text-danger">' + json['error']['option'][i] + '</div>');
            }
            $('.text-danger').parent().addClass('mi-form-group--has-error');
          }
        }
        if (json['success']) {
          /* S19 ANALYTICS: GA4 add_to_cart with full item data */
          try {
            var miQty = parseInt($('#input-quantity').val(), 10) || 1;
            var miItem = Object.assign({}, window.miItem || {item_id: '{{ product_id }}'});
            miItem.quantity = miQty;
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({ecommerce: null});
            window.dataLayer.push({
              event: 'add_to_cart',
              ecommerce: {
                currency: '{{ schema_currency|default("USD") }}',
                {% if schema_price %}value: {{ schema_price }} * miQty,{% endif %}
                items: [miItem]
              }
            });
          } catch(e){}
          $('.mi-breadcrumb').after('<div class="mi-alert mi-alert--success">' + json['success'] + ' <button type="button" class="mi-alert__close" onclick="this.parentNode.remove()">×</button></div>');
          // Update the header cart badge with just the item count (json['total'] is "N item(s) - $X.XX")
          // We pull the leading integer; if absent, fall back to the full string.
          var totalStr = (json['total'] || '').toString();
          var countMatch = totalStr.match(/(\d+)/);
          var countText = countMatch ? countMatch[1] : totalStr;
          $('#cart-total').text(countText).addClass('mi-icon-btn__badge');
          // Refresh the dropdown panel and re-emit a mutation so the cart shim re-renders the icon
          $('#cart > ul').load('index.php?route=common/cart/info ul li', function() {
            // Trigger a no-op DOM tick on #cart > button so the MutationObserver in footer.twig fires
            var btn = document.querySelector('#cart > button');
            if (btn && !btn.querySelector('.mi-cart__icon')) {
              btn.dispatchEvent(new Event('mi-cart-refresh'));
            }
          });
          $('html, body').animate({ scrollTop: 0 }, 'slow');
        }
      }
    });
  });

  // ── 11. Reviews (OpenCart standard) ─────────────────
  {% if review_status %}
  $('#review').delegate('.pagination a', 'click', function(e) {
    e.preventDefault();
    $('#review').load(this.href);
  });
  $('#review').load('index.php?route=product/product/review&product_id={{ product_id }}');

  $('#button-review').on('click', function() {
    $.ajax({
      url: 'index.php?route=product/product/write&product_id={{ product_id }}',
      type: 'post',
      dataType: 'json',
      data: $('#form-review').serialize(),
      beforeSend: function() {
        $('#button-review').prop('disabled', true);
      },
      complete: function() {
        $('#button-review').prop('disabled', false);
      },
      success: function(json) {
        $('.mi-alert').remove();
        if (json['error']) {
          $('#review').after('<div class="mi-alert mi-alert--error">' + json['error'] + '</div>');
        }
        if (json['success']) {
          $('#review').after('<div class="mi-alert mi-alert--success">' + json['success'] + '</div>');
          $('input[name="name"]').val('');
          $('textarea[name="text"]').val('');
          $('input[name="rating"]:checked').prop('checked', false);
        }
      }
    });
  });
  {% endif %}

})();
</script>

{{ footer }}
