{{ header }}

{% if schema_price or (review_count > 0 and rating > 0) %}
{# ── B5 Product JSON-LD (Session 15, additive; v3). Leading-comma pattern keeps JSON valid in every branch. ── #}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ heading_title|json_encode|raw }}
  {%- if popup %},
  "image": [
    {{ popup|json_encode|raw }}
    {%- for img in images %},
    {{ img.popup|json_encode|raw }}
    {%- endfor %}
  ]
  {%- endif %}
  {%- if schema_description %},
  "description": {{ schema_description|json_encode|raw }}
  {%- endif %}
  {%- if model %},
  "sku": {{ model|json_encode|raw }},
  "mpn": {{ model|json_encode|raw }}
  {%- endif %}
  {%- if manufacturer %},
  "brand": {
    "@type": "Brand",
    "name": {{ manufacturer|json_encode|raw }}
  }
  {%- endif %}
  {%- if review_count > 0 and rating > 0 %},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ rating }}",
    "reviewCount": "{{ review_count }}",
    "bestRating": "5",
    "worstRating": "1"
  }
  {%- endif %}
  {%- if schema_price %},
  "offers": {
    "@type": "Offer",
    "url": {{ share|json_encode|raw }},
    "priceCurrency": {{ schema_currency|json_encode|raw }},
    "price": "{{ schema_price }}",
    "priceValidUntil": "{{ 'now'|date_modify('+1 year')|date('Y-m-d') }}",
    "availability": "https://schema.org/{{ schema_availability }}",
    "itemCondition": "https://schema.org/{{ schema_condition }}",
    "seller": {
      "@type": "Organization",
      "name": "The Miner Island"
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": ["US","CA","GB","AU","DE","FR","NL","ES","IT","PL","SE","FI","AT","BE","CH"],
      "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted"
    },
    "warranty": {
      "@type": "WarrantyPromise",
      "durationOfWarranty": {
        "@type": "QuantitativeValue",
        "value": "60",
        "unitCode": "DAY"
      }
    }
  }
  {%- endif %}
}
</script>
{# ── end B5 ── #}
{% endif %}

{% if breadcrumbs is defined and breadcrumbs|length > 0 %}
{# ── B6 BreadcrumbList JSON-LD (Session 15, additive; v2) ── #}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {%- for breadcrumb in breadcrumbs %}
    {%- set crumb_name = breadcrumb.text|striptags|trim %}
    {%- if crumb_name is empty %}{% set crumb_name = 'Home' %}{% endif %}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "name": {{ crumb_name|json_encode|raw }},
      "item": {{ breadcrumb.href|replace({'&amp;': '&'})|json_encode|raw }}
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{# ── end B6 ── #}
{% endif %}

{# ═══ S19 ANALYTICS: GA4 view_item ══════════════════════════════════════════
   Pushed once per product page. Numeric price comes from schema_price (same
   clean value the Product JSON-LD uses); falls back to omitting price when a
   product has no schema price. window.miItem is reused by the add to cart
   handler below so both events carry identical item data.
   ══════════════════════════════════════════════════════════════════════════ #}
<script>
window.dataLayer = window.dataLayer || [];
window.miItem = {
  item_id: '{{ product_id }}',
  item_name: {{ heading_title|json_encode|raw }}{% if manufacturer %},
  item_brand: {{ manufacturer|json_encode|raw }}{% endif %}{% if schema_price %},
  price: {{ schema_price }}{% endif %}
};
window.dataLayer.push({ecommerce: null});
window.dataLayer.push({
  event: 'view_item',
  ecommerce: {
    currency: '{{ schema_currency|default("USD") }}',
    {% if schema_price %}value: {{ schema_price }},{% endif %}
    items: [window.miItem]
  }
});
</script>

<div class="mi-product-page" id="product-product">
  <div class="mi-container">

    {# ── Breadcrumb ────────────────────────────────────────── #}
    <nav class="mi-breadcrumb" aria-label="Breadcrumb">
      <ol>
        {% for breadcrumb in breadcrumbs %}
          <li>
            <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
            {% if not loop.last %}<span aria-hidden="true">›</span>{% endif %}
          </li>
        {% endfor %}
      </ol>
    </nav>

    {# ── Top: gallery + buy box ───────────────────────────── #}
    <div class="mi-product-top">

      {# Gallery ─────────────────── #}
      <div class="mi-gallery">
        <div class="mi-gallery__main" id="mi-gallery-main">
          {% if thumb %}
            <img src="{{ thumb }}"
                 data-full="{{ popup }}"
                 alt="{{ heading_title }}"
                 id="mi-gallery-img"
                 class="mi-gallery__img">
          {% else %}
            <div class="mi-gallery__empty" aria-hidden="true">
              <span>⛏</span>
              <p>Image coming soon</p>
            </div>
          {% endif %}
          {% if thumb %}
            <button type="button" class="mi-gallery__zoom" id="mi-gallery-zoom" aria-label="Zoom image">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/>
                <line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>
              </svg>
            </button>
          {% endif %}
        </div>

        {% if images %}
          <div class="mi-gallery__thumbs" role="tablist" aria-label="Product images">
            {% if thumb %}
              <button type="button"
                      class="mi-gallery__thumb mi-gallery__thumb--active"
                      data-img="{{ thumb }}"
                      data-full="{{ popup }}"
                      aria-label="Main image">
                <img src="{{ thumb }}" alt="">
              </button>
            {% endif %}
            {% for image in images %}
              <button type="button"
                      class="mi-gallery__thumb"
                      data-img="{{ image.thumb }}"
                      data-full="{{ image.popup }}"
                      aria-label="View image {{ loop.index + 1 }}">
                <img src="{{ image.thumb }}" alt="">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      {# Buy box ─────────────────── #}
      <div class="mi-buybox">

        {% if manufacturer %}
          <a href="{{ manufacturers }}" class="mi-buybox__brand">{{ manufacturer }}</a>
        {% endif %}

        <h1 class="mi-buybox__title">{{ heading_title }}</h1>

        {# Tier badge, parsed from description efficiency on the JS side after render #}
        <div class="mi-buybox__tier" id="mi-tier-badge" hidden></div>

        {# Spec strip (mono) #}
        <!-- SPEC-PARSE-v2 -->
        <dl class="mi-spec-strip" id="mi-spec-strip"></dl>

        {# Price block #}
        {% if price %}
          <div class="mi-buybox__price">
            {% if special %}
              <span class="mi-buybox__price-new" id="mi-price-current">{{ special }}</span>
              <span class="mi-buybox__price-old">{{ price }}</span>
              <span class="mi-buybox__savings" id="mi-savings"></span>
            {% else %}
              <span class="mi-buybox__price-new" id="mi-price-current">{{ price }}</span>
            {% endif %}
          </div>
          <div class="mi-buybox__btc">
            <span class="mi-buybox__btc-icon">₿</span>
            <span><strong>Pay in BTC, save 3%</strong> on your entire order. Handled at checkout via Plisio.</span>
          </div>
        {% endif %}

        {# Stock #}
        <div class="mi-buybox__stock">
          <span class="mi-buybox__stock-dot"></span>
          <span>{{ stock }}</span>
        </div>

        {# Add to cart + WhatsApp #}
        <div id="product" class="mi-buybox__cart">
          <input type="hidden" name="product_id" value="{{ product_id }}">

          {# Options, render plainly; rare on this catalog but kept compatible #}
          {% if options %}
            <div class="mi-buybox__options">
              {% for option in options %}
                {% if option.type == 'select' %}
                  <div class="mi-form-group{% if option.required %} mi-form-group--required{% endif %}">
                    <label for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
                    <select name="option[{{ option.product_option_id }}]" id="input-option{{ option.product_option_id }}" class="mi-input">
                      <option value="">{{ text_select }}</option>
                      {% for ov in option.product_option_value %}
                        <option value="{{ ov.product_option_value_id }}">{{ ov.name }}{% if ov.price %} ({{ ov.price_prefix }}{{ ov.price }}){% endif %}</option>
                      {% endfor %}
                    </select>
                  </div>
                {% elseif option.type == 'radio' %}
                  <div class="mi-form-group{% if option.required %} mi-form-group--required{% endif %}">
                    <label>{{ option.name }}</label>
                    <div id="input-option{{ option.product_option_id }}">
                      {% for ov in option.product_option_value %}
                        <label class="mi-radio">
                          <input type="radio" name="option[{{ option.product_option_id }}]" value="{{ ov.product_option_value_id }}">
                          {{ ov.name }}{% if ov.price %} ({{ ov.price_prefix }}{{ ov.price }}){% endif %}
                        </label>
                      {% endfor %}
                    </div>
                  </div>
                {% elseif option.type == 'text' %}
                  <div class="mi-form-group{% if option.required %} mi-form-group--required{% endif %}">
                    <label for="input-option{{ option.product_option_id }}">{{ option.name }}</label>
                    <input type="text" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" id="input-option{{ option.product_option_id }}" class="mi-input">
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}

          <div class="mi-buybox__cart-row">
            <div class="mi-qty">
              <button type="button" class="mi-qty__btn" data-step="-1" aria-label="Decrease quantity">−</button>
              <input type="text" name="quantity" value="{{ minimum }}" id="input-quantity" class="mi-qty__input" inputmode="numeric">
              <button type="button" class="mi-qty__btn" data-step="1" aria-label="Increase quantity">+</button>
            </div>
            <button type="button"
                    id="button-cart"
                    data-loading-text="{{ text_loading }}"
                    class="mi-btn mi-btn--primary mi-btn--lg mi-buybox__add">
