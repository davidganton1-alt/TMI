<script>
/* ═══ s25f — MOBILE DRAWER: inline-onclick architecture ═══════════════════
   Why: addEventListener bindings on the hamburger were being duplicated
   or killed by earlier script versions / node clones (two listeners on
   one click = open+close = looks like nothing happens). Inline onclick
   attributes can't double-bind and survive cloning. On window.load we
   clone the hamburger ONCE to wipe any stale addEventListener handlers
   left by older script versions.
   ═════════════════════════════════════════════════════════════════════ */
(function () {
  'use strict';

  function drawerEl() { return document.getElementById('mi-mobile-drawer'); }

  window.miDrawerOpen = function () {
    var d = drawerEl(); if (!d) return;
    d.classList.add('is-open');
    d.setAttribute('aria-hidden', 'false');
    var t = document.getElementById('mi-menu-toggle');
    if (t) t.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    console.log('[mi] drawer OPEN');
  };

  window.miDrawerClose = function () {
    var d = drawerEl(); if (!d) return;
    d.classList.remove('is-open');
    d.setAttribute('aria-hidden', 'true');
    var t = document.getElementById('mi-menu-toggle');
    if (t) t.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    console.log('[mi] drawer CLOSE');
  };

  window.miDrawerToggle = function () {
    var d = drawerEl();
    if (!d) { console.log('[mi] drawer element MISSING'); return; }
    if (d.classList.contains('is-open')) { window.miDrawerClose(); } else { window.miDrawerOpen(); }
  };

  /* Kill stale addEventListener handlers on the hamburger.
     The inline onclick attribute survives this clone. */
  window.addEventListener('load', function () {
    var t = document.getElementById('mi-menu-toggle');
    if (t && !t.hasAttribute('data-mi-cloned')) {
      var c = t.cloneNode(true);
      c.setAttribute('data-mi-cloned', '1');
      t.parentNode.replaceChild(c, t);
    }
  });

  /* ── Search (unchanged — this already works, don't touch) ── */
  var searchToggle = document.getElementById('mi-search-toggle');
  var searchForm = document.querySelector('.mi-search') || document.getElementById('search');

  if (searchToggle && !searchToggle.hasAttribute('data-mi-bound')) {
    searchToggle.setAttribute('data-mi-bound', '1');
    searchToggle.addEventListener('click', function (e) {
      e.preventDefault();
      if (!searchForm) return;
      searchForm.classList.toggle('is-open');
      if (searchForm.classList.contains('is-open')) {
        var input = searchForm.querySelector('input[type="text"], input[name="search"]');
        if (input) setTimeout(function () { input.focus(); }, 100);
      }
    });
  }

  document.addEventListener('click', function (e) {
    if (searchForm && searchForm.classList.contains('is-open')) {
      var st = document.getElementById('mi-search-toggle');
      if (!searchForm.contains(e.target) && e.target !== st && !(st && st.contains(e.target))) {
        searchForm.classList.remove('is-open');
      }
    }
  });

  /* ── Escape closes both ── */
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' || e.keyCode === 27) {
      window.miDrawerClose();
      if (searchForm) searchForm.classList.remove('is-open');
    }
  });
})();
</script>