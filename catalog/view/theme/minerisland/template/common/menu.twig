{# Main category navigation, rendered into header.twig at {{ menu }} #}
{# OpenCart populates `categories` from System → Design → Layouts → Menu items #}

{% if categories %}
<nav class="mi-nav mi-d-none mi-d-lg-block" id="mi-nav" aria-label="Product categories">
  <div class="mi-container">
    <ul class="mi-nav__inner">
      {% for category in categories %}
        <li class="mi-nav__item{% if category.children %} mi-nav__item--has-children{% endif %}">
          <a href="{{ category.href }}" class="mi-nav__link">
            {{ category.name }}
            {% if category.children %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:12px;height:12px;margin-left:4px;"><polyline points="6 9 12 15 18 9"/></svg>
            {% endif %}
          </a>

          {% if category.children %}
            <div class="mi-nav__dropdown">
              <div class="mi-nav__dropdown-inner">
                {% set col_size = (category.children|length / (category.column|default(1))|round(1, 'ceil'))|round(0, 'ceil') %}
                {% for chunk in category.children|batch(col_size > 0 ? col_size : category.children|length) %}
                  <ul class="mi-nav__dropdown-col">
                    {% for child in chunk %}
                      <li><a href="{{ child.href }}">{{ child.name }}</a></li>
                    {% endfor %}
                  </ul>
                {% endfor %}
              </div>
              <a href="{{ category.href }}" class="mi-nav__see-all">
                {{ text_all|default('View all') }} {{ category.name }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:14px;height:14px;margin-left:4px;vertical-align:-2px;"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>
          {% endif %}
        </li>
      {% endfor %}

      {# ═══ MinerIsland Phase 7: "Company" dropdown ═════════════════════════
         Hardcoded, not category-driven. Houses the trust pages: team, blog,
         about, corporate verification. Slugs verified against oc_seo_url. #}
      <li class="mi-nav__item mi-nav__item--has-children mi-nav__item--company">
        <a href="our-team" class="mi-nav__link">
          Company
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:12px;height:12px;margin-left:4px;"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="mi-nav__dropdown">
          <div class="mi-nav__dropdown-inner">
            <ul class="mi-nav__dropdown-col">
              <li><a href="our-team">Our Team</a></li>
              <li><a href="factory-updates">Blog Updates</a></li>
              <li><a href="our-story">About Us</a></li>
              <li><a href="business-credentials">Corporate Verification</a></li>
              <li><a href="staff-verification">Staff Verification</a></li>
            </ul>
          </div>
          <a href="our-team" class="mi-nav__see-all">
            Meet the team
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:14px;height:14px;margin-left:4px;vertical-align:-2px;"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </li>
      {# ═══ END Phase 7 Company dropdown ═══════════════════════════════════ #}
    </ul>
  </div>
</nav>
{% endif %}
