{% if fail %}
  <div class="mi-alert mi-alert--error">
    <strong>Payment didn't go through.</strong> {{ fail }}
    <p style="margin-top: 6px;">Try again, or message us on WhatsApp and we'll sort it manually.</p>
  </div>
{% endif %}

<form action="{{ action }}" method="post" class="mi-plisio-confirm">
  <div class="mi-plisio-confirm__row">
    <div class="mi-plisio-confirm__pitch">
      <span class="mi-plisio-confirm__icon">₿</span>
      <div>
        <strong>Pay with crypto · 3% off</strong>
        <small>You'll be taken to a secure window to send Bitcoin, ETH, USDT, or 12+ other coins. Your order starts the moment payment confirms.</small>
      </div>
    </div>
    <button type="submit" class="mi-btn mi-btn--orange mi-btn--lg mi-plisio-confirm__btn">
      {{ white_label ? 'Continue to payment' : 'Pay with Plisio' }}
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" style="margin-left: 6px;"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12,5 19,12 12,19"/></svg>
    </button>
  </div>
</form>
