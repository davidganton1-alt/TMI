{% if error_warning %}
  <div class="mi-alert mi-alert--error alert alert-warning alert-dismissible">{{ error_warning }}</div>
{% endif %}

{% if payment_methods %}
  <p class="mi-checkout-step__lead">{{ text_payment_method }}</p>

  <div class="mi-pay-methods">
    {% for payment_method in payment_methods %}
      {% set is_crypto = (payment_method.code starts with 'plisio') or (payment_method.code starts with 'pp_crypto') %}
      <label class="mi-pay-method{% if is_crypto %} mi-pay-method--crypto{% endif %}">
        {% if payment_method.code == code or not code %}
          {% set code = payment_method.code %}
          <input type="radio" name="payment_method" value="{{ payment_method.code }}" checked="checked" class="mi-pay-method__radio">
        {% else %}
          <input type="radio" name="payment_method" value="{{ payment_method.code }}" class="mi-pay-method__radio">
        {% endif %}
        <span class="mi-pay-method__indicator" aria-hidden="true"></span>
        <span class="mi-pay-method__body">
          <span class="mi-pay-method__title">
            {% if is_crypto %}<span class="mi-pay-method__icon">₿</span>{% endif %}
            {{ payment_method.title }}
            {% if is_crypto %}<span class="mi-pay-method__badge">Save 3%</span>{% endif %}
          </span>
          {% if payment_method.terms %}
            <span class="mi-pay-method__terms">{{ payment_method.terms }}</span>
          {% endif %}
          {% if is_crypto %}
            <span class="mi-pay-method__crypto-note">Pay with BTC, ETH, USDT, USDC, LTC and 12+ other coins via Plisio. The 3% discount applies automatically on the next step.</span>
          {% endif %}
        </span>
      </label>
    {% endfor %}
  </div>
{% endif %}

<div class="mi-checkout-step__field">
  <label for="comment" class="mi-checkout-step__label">{{ text_comments }}</label>
  <textarea name="comment" id="comment" rows="4" class="form-control mi-input" placeholder="Special instructions, delivery notes, or anything we should know about this order">{{ comment }}</textarea>
</div>

<div class="mi-checkout-step__footer">
  {% if text_agree %}
    <label class="mi-pay-agree">
      {% if agree %}
        <input type="checkbox" name="agree" value="1" checked="checked">
      {% else %}
        <input type="checkbox" name="agree" value="1">
      {% endif %}
      <span>{{ text_agree }}</span>
    </label>
  {% endif %}

  <input type="button" value="{{ button_continue }}" id="button-payment-method" data-loading-text="{{ text_loading }}" class="btn btn-primary mi-btn mi-btn--primary mi-btn--lg">
</div>

<script>
// :has() fallback, toggle a class on the selected radio's wrapper
(function() {
  function syncSelected() {
    document.querySelectorAll('.mi-pay-method').forEach(el => {
      const radio = el.querySelector('.mi-pay-method__radio');
      el.classList.toggle('mi-pay-method--selected', !!(radio && radio.checked));
    });
  }
  document.querySelectorAll('.mi-pay-method__radio').forEach(r => {
    r.addEventListener('change', syncSelected);
  });
  syncSelected();
})();
</script>

{# S19 ANALYTICS: GA4 add_payment_info on step continue #}
<script>
(function(){
  var btn = document.getElementById('button-payment-method');
  if (btn && !btn._miTracked) {
    btn._miTracked = true;
    btn.addEventListener('click', function(){
      var sel = document.querySelector('input[name="payment_method"]:checked');
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ecommerce: null});
      window.dataLayer.push({
        event: 'add_payment_info',
        ecommerce: { currency: 'USD', payment_type: sel ? sel.value : 'unknown' }
      });
    }, false);
  }
})();
</script>
