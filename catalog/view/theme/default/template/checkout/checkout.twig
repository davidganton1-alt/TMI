{{ header }}

<style>
/* ═══════════════════════════════════════════════════════════════
   PREMIUM CHECKOUT DESIGN
   Modern, clean, high-converting checkout experience
   ═══════════════════════════════════════════════════════════════ */

.mi-checkout-wrapper {
  background: var(--mi-bg-soft, #F8FAFC);
  min-height: 100vh;
  padding: 32px 24px;
}

.mi-checkout-inner {
  max-width: 1200px;
  margin: 0 auto;
}

/* Header */
.mi-checkout-header {
  text-align: center;
  margin-bottom: 48px;
}

.mi-checkout-logo {
  width: 48px;
  height: 48px;
  margin: 0 auto 20px;
  background: var(--mi-color-primary, #2563EB);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
}

.mi-checkout-logo svg {
  width: 28px;
  height: 28px;
  color: white;
}

.mi-checkout-title {
  font-size: 36px;
  font-weight: 700;
  color: var(--mi-text-headline, #0F172A);
  margin: 0 0 12px;
  letter-spacing: -0.02em;
}

.mi-checkout-subtitle {
  font-size: 18px;
  color: var(--mi-text-secondary, #64748B);
  margin: 0;
}

/* Progress Bar */
.mi-progress-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0;
  margin-bottom: 48px;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.mi-progress-step {
  display: flex;
  align-items: center;
  gap: 12px;
  position: relative;
}

.mi-progress-circle {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 16px;
  transition: all 0.3s ease;
  position: relative;
  z-index: 2;
}

.mi-progress-step.active .mi-progress-circle {
  background: var(--mi-color-primary, #2563EB);
  color: white;
  box-shadow: 0 0 0 6px rgba(37, 99, 235, 0.15);
}

.mi-progress-step.completed .mi-progress-circle {
  background: var(--mi-color-success, #10B981);
  color: white;
}

.mi-progress-step:not(.active):not(.completed) .mi-progress-circle {
  background: var(--mi-bg-card, #FFFFFF);
  color: var(--mi-text-muted, #94A3B8);
  border: 2px solid var(--mi-border-subtle, #E2E8F0);
}

.mi-progress-label {
  font-size: 14px;
  font-weight: 500;
  color: var(--mi-text-secondary, #64748B);
  white-space: nowrap;
}

.mi-progress-step.active .mi-progress-label {
  color: var(--mi-text-headline, #0F172A);
  font-weight: 600;
}

.mi-progress-connector {
  flex: 1;
  height: 2px;
  background: var(--mi-border-subtle, #E2E8F0);
  margin: 0 16px;
  position: relative;
}

.mi-progress-connector.completed {
  background: var(--mi-color-success, #10B981);
}

/* Two Column Layout */
.mi-checkout-layout {
  display: grid;
  grid-template-columns: 1fr 400px;
  gap: 32px;
  align-items: start;
}

/* Main Column */
.mi-checkout-main {
  display: flex;
  flex-direction: column;
  gap: 28px;
}

/* Step Cards */
.mi-step-card {
  background: var(--mi-bg-card, #FFFFFF);
  border: 1px solid var(--mi-border-subtle, #E2E8F0);
  border-radius: 16px;
  overflow: hidden;
  transition: all 0.2s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.mi-step-card:hover {
  border-color: var(--mi-border-defined, #CBD5E1);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
}

.mi-step-card.active {
  border-color: var(--mi-color-primary, #2563EB);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1), 0 4px 16px rgba(0, 0, 0, 0.08);
}

.mi-step-header {
  padding: 24px;
  background: var(--mi-bg-soft, #F8FAFC);
  border-bottom: 1px solid var(--mi-border-subtle, #E2E8F0);
  display: flex;
  align-items: center;
  gap: 16px;
  cursor: pointer;
  transition: background 0.2s ease;
}

.mi-step-header:hover {
  background: #F1F5F9;
}

/* ALL STEP ICONS — uniform theme blue */
.mi-step-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(37, 99, 235, 0.1);
  color: var(--mi-color-primary, #2563EB);
}

.mi-step-icon svg {
  width: 24px;
  height: 24px;
}

.mi-step-title-group {
  flex: 1;
}

.mi-step-number {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--mi-text-muted, #94A3B8);
  margin-bottom: 4px;
}

.mi-step-title {
  font-size: 20px;
  font-weight: 600;
  color: var(--mi-text-headline, #0F172A);
  margin: 0;
}

.mi-step-chevron {
  color: var(--mi-text-muted, #94A3B8);
  transition: transform 0.2s ease;
}

.mi-step-header[aria-expanded="true"] .mi-step-chevron {
  transform: rotate(180deg);
}

.mi-step-body {
  padding: 32px;
}

/* Override Bootstrap panel styles */
.panel-group {
  margin: 0;
}

.panel {
  margin: 0;
  border: none;
  box-shadow: none;
  background: transparent;
}

.panel-heading {
  padding: 0;
  border: none;
  background: transparent;
}

.panel-title {
  margin: 0;
  font-size: inherit;
  font-weight: inherit;
}

.panel-title a {
  display: block;
  text-decoration: none;
  color: inherit;
}

.panel-collapse {
  border: none;
}

.panel-body {
  padding: 0;
}

/* Sidebar */
.mi-checkout-sidebar {
  position: sticky;
  top: 32px;
}

.mi-order-summary {
  background: var(--mi-bg-card, #FFFFFF);
  border: 1px solid var(--mi-border-subtle, #E2E8F0);
  border-radius: 16px;
  padding: 28px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  margin-bottom: 20px;
}

.mi-summary-title {
  font-size: 20px;
  font-weight: 600;
  color: var(--mi-text-headline, #0F172A);
  margin: 0 0 24px;
}

.mi-summary-placeholder {
  padding: 40px 20px;
  text-align: center;
  color: var(--mi-text-muted, #94A3B8);
  font-size: 14px;
  border: 2px dashed var(--mi-border-subtle, #E2E8F0);
  border-radius: 12px;
}

/* Trust Badges */
.mi-trust-badges {
  background: var(--mi-bg-card, #FFFFFF);
  border: 1px solid var(--mi-border-subtle, #E2E8F0);
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.mi-trust-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--mi-text-headline, #0F172A);
  margin: 0 0 20px;
}

.mi-trust-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.mi-trust-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.mi-trust-icon-wrap {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(37, 99, 235, 0.1);
  color: var(--mi-color-primary, #2563EB);
}

.mi-trust-icon-wrap svg {
  width: 20px;
  height: 20px;
}

.mi-trust-content {
  flex: 1;
}

.mi-trust-label {
  font-size: 14px;
  font-weight: 600;
  color: var(--mi-text-headline, #0F172A);
  margin: 0 0 2px;
}

.mi-trust-desc {
  font-size: 13px;
  color: var(--mi-text-secondary, #64748B);
  margin: 0;
  line-height: 1.4;
}

/* Alert Styles */
.alert {
  border-radius: 12px;
  padding: 16px 20px;
  border: 1px solid;
  margin-bottom: 24px;
}

.alert-danger {
  background: #FEF2F2;
  border-color: #FCA5A5;
  color: #991B1B;
}

.alert-success {
  background: #F0FDF4;
  border-color: #86EFAC;
  color: #166534;
}

.alert-warning {
  background: #FFFBEB;
  border-color: #FCD34D;
  color: #92400E;
}

.alert-dismissible .close {
  float: right;
  font-size: 20px;
  font-weight: 700;
  line-height: 1;
  color: inherit;
  text-shadow: none;
  opacity: 0.5;
  background: none;
  border: none;
  cursor: pointer;
}

/* Responsive */
@media (max-width: 1024px) {
  .mi-checkout-layout {
    grid-template-columns: 1fr;
  }
  
  .mi-checkout-sidebar {
    position: static;
  }
}

@media (max-width: 768px) {
  .mi-checkout-wrapper {
    padding: 20px 16px;
  }
  
  .mi-checkout-title {
    font-size: 28px;
  }
  
  .mi-progress-bar {
    flex-wrap: wrap;
    gap: 12px;
  }
  
  .mi-progress-connector {
    display: none;
  }
  
  .mi-step-body {
    padding: 20px;
  }
  
  .mi-step-title {
    font-size: 18px;
  }
}

/* Loading States */
.btn-loading {
  opacity: 0.6;
  pointer-events: none;
}

/* Form Enhancements */
.form-control {
  border-radius: 8px;
  border: 1px solid var(--mi-border-defined, #CBD5E1);
  padding: 12px 16px;
  font-size: 15px;
  transition: all 0.2s ease;
}

.form-control:focus {
  border-color: var(--mi-color-primary, #2563EB);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  outline: none;
}

.has-error .form-control {
  border-color: #EF4444;
  box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
}

.text-danger {
  color: #EF4444;
  font-size: 13px;
  margin-top: 6px;
}

/* ═══════════════════════════════════════════════════════════════
   BUTTON COLOR OVERRIDE — forces all checkout buttons to blue
   ═══════════════════════════════════════════════════════════════ */
.mi-step-body .btn,
.mi-step-body .btn-primary,
.mi-step-body .btn-success,
.mi-step-body .btn-info,
.mi-step-body button[type="submit"],
.mi-step-body input[type="submit"],
.mi-step-body #button-login,
.mi-step-body #button-register,
.mi-step-body #button-guest,
.mi-step-body #button-account,
.mi-step-body #button-payment-address,
.mi-step-body #button-shipping-address,
.mi-step-body #button-guest-shipping,
.mi-step-body #button-shipping-method,
.mi-step-body #button-payment-method,
.mi-step-body #button-confirm,
.mi-step-body #button-quote {
  background: var(--mi-color-primary, #2563EB) !important;
  border-color: var(--mi-color-primary, #2563EB) !important;
  color: #fff !important;
  border-radius: 8px !important;
  padding: 10px 22px !important;
  font-weight: 600 !important;
  transition: all 0.2s ease !important;
}

.mi-step-body .btn:hover,
.mi-step-body .btn-primary:hover,
.mi-step-body .btn-success:hover,
.mi-step-body #button-confirm:hover,
.mi-step-body #button-login:hover,
.mi-step-body #button-register:hover,
.mi-step-body #button-guest:hover,
.mi-step-body #button-payment-method:hover,
.mi-step-body #button-shipping-method:hover {
  background: var(--mi-color-primary-dark, #1D4ED8) !important;
  border-color: var(--mi-color-primary-dark, #1D4ED8) !important;
  transform: translateY(-1px) !important;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3) !important;
}

/* Keep secondary/outline buttons light */
.mi-step-body .btn-default,
.mi-step-body .btn-link {
  background: transparent !important;
  border-color: var(--mi-border-defined, #CBD5E1) !important;
  color: var(--mi-text-headline, #0F172A) !important;
}

.mi-step-body .btn-default:hover {
  background: var(--mi-bg-soft, #F8FAFC) !important;
  color: var(--mi-color-primary, #2563EB) !important;
}
</style>

<div class="mi-checkout-wrapper">
  <div class="mi-checkout-inner">
    
    {# Header #}
    <div class="mi-checkout-header">
      <div class="mi-checkout-logo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/>
          <path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
      </div>
      <h1 class="mi-checkout-title">Secure Checkout</h1>
      <p class="mi-checkout-subtitle">Complete your purchase with confidence</p>
    </div>

    {# Progress Bar #}
    <div class="mi-progress-bar">
      <div class="mi-progress-step active">
        <div class="mi-progress-circle">1</div>
        <span class="mi-progress-label">Account</span>
      </div>
      <div class="mi-progress-connector"></div>
      {% if shipping_required %}
      <div class="mi-progress-step">
        <div class="mi-progress-circle">2</div>
        <span class="mi-progress-label">Shipping</span>
      </div>
      <div class="mi-progress-connector"></div>
      {% endif %}
      <div class="mi-progress-step">
        <div class="mi-progress-circle">{% if shipping_required %}3{% else %}2{% endif %}</div>
        <span class="mi-progress-label">Payment</span>
      </div>
      <div class="mi-progress-connector"></div>
      <div class="mi-progress-step">
        <div class="mi-progress-circle">{% if shipping_required %}4{% else %}3{% endif %}</div>
        <span class="mi-progress-label">Confirm</span>
      </div>
    </div>

    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible">
      <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    {# Two Column Layout #}
    <div class="mi-checkout-layout">
      
      {# Main Column #}
      <div class="mi-checkout-main">
        <div id="accordion" class="panel-group">
          
          {# Step 1: Checkout Option #}
          <div class="mi-step-card panel panel-default">
            <div class="panel-heading mi-step-header">
              <div class="mi-step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
              </div>
              <div class="mi-step-title-group">
                <div class="mi-step-number">Step 1</div>
                <h4 class="mi-step-title panel-title">{{ text_checkout_option }}</h4>
              </div>
              <svg class="mi-step-chevron" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </div>
            <div class="panel-collapse collapse" id="collapse-checkout-option">
              <div class="panel-body mi-step-body"></div>
            </div>
          </div>

          {# Step 2: Account / Payment Address #}
          {% if not logged and account != 'guest' %}
          <div class="mi-step-card panel panel-default">
            <div class="panel-heading mi-step-header">
              <div class="mi-step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
              </div>
              <div class="mi-step-title-group">
                <div class="mi-step-number">Step 2</div>
                <h4 class="mi-step-title panel-title">{{ text_checkout_account }}</h4>
              </div>
              <svg class="mi-step-chevron" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </div>
            <div class="panel-collapse collapse" id="collapse-payment-address">
              <div class="panel-body mi-step-body"></div>
            </div>
          </div>
          {% else %}
          <div class="mi-step-card panel panel-default">
            <div class="panel-heading mi-step-header">
              <div class="mi-step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div class="mi-step-title-group">
                <div class="mi-step-number">Step 2</div>
                <h4 class="mi-step-title panel-title">{{ text_checkout_payment_address }}</h4>
              </div>
              <svg class="mi-step-chevron" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </div>
            <div class="panel-collapse collapse" id="collapse-payment-address">
              <div class="panel-body mi-step-body"></div>
            </div>
          </div>
          {% endif %}

          {# Step 3: Shipping Address (if required) #}
          {% if shipping_required %}
          <div class="mi-step-card panel panel-default">
            <div class="panel-heading mi-step-header">
              <div class="mi-step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="1" y="3" width="15" height="13"/>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                  <circle cx="5.5" cy="18.5" r="2.5"/>
                  <circle cx="18.5" cy="18.5" r="2.5"/>
                </svg>
              </div>
              <div class="mi-step-title-group">
                <div class="mi-step-number">Step 3</div>
                <h4 class="mi-step-title panel-title">{{ text_checkout_shipping_address }}</h4>
              </div>
              <svg class="mi-step-chevron" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </div>
            <div class="panel-collapse collapse" id="collapse-shipping-address">
              <div class="panel-body mi-step-body"></div>
            </div>
          </div>

          {# Step 4: Shipping Method #}
          <div class="mi-step-card panel panel-default">
            <div class="panel-heading mi-step-header">
              <div class="mi-step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M16 3h5v5"/>
                  <line x1="8" y1="21" x2="21" y2="8"/>
                  <polyline points="4 17 4 21 8 21"/>
                </svg>
              </div>
              <div class="mi-step-title-group">
                <div class="mi-step-number">Step 4</div>
                <h4 class="mi-step-title panel-title">{{ text_checkout_shipping_method }}</h4>
              </div>
              <svg class="mi-step-chevron" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </div>
            <div class="panel-collapse collapse" id="collapse-shipping-method">
              <div class="panel-body mi-step-body"></div>
            </div>
          </div>
          {% endif %}

          {# Step 5: Payment Method #}
          <div class="mi-step-card panel panel-default">
            <div class="panel-heading mi-step-header">
              <div class="mi-step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                  <line x1="1" y1="10" x2="23" y2="10"/>
                </svg>
              </div>
              <div class="mi-step-title-group">
                <div class="mi-step-number">Step {% if shipping_required %}5{% else %}3{% endif %}</div>
                <h4 class="mi-step-title panel-title">{{ text_checkout_payment_method }}</h4>
              </div>
              <svg class="mi-step-chevron" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </div>
            <div class="panel-collapse collapse" id="collapse-payment-method">
              <div class="panel-body mi-step-body"></div>
            </div>
          </div>

          {# Step 6: Confirm Order #}
          <div class="mi-step-card panel panel-default">
            <div class="panel-heading mi-step-header">
              <div class="mi-step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </div>
              <div class="mi-step-title-group">
                <div class="mi-step-number">Step {% if shipping_required %}6{% else %}4{% endif %}</div>
                <h4 class="mi-step-title panel-title">{{ text_checkout_confirm }}</h4>
              </div>
              <svg class="mi-step-chevron" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </div>
            <div class="panel-collapse collapse" id="collapse-checkout-confirm">
              <div class="panel-body mi-step-body"></div>
            </div>
          </div>

        </div>
      </div>

      {# Sidebar #}
      <div class="mi-checkout-sidebar">
        
        {# Order Summary #}
        <div class="mi-order-summary">
          <h3 class="mi-summary-title">Order Summary</h3>
          <div class="mi-summary-placeholder">
            Your order details will appear here as you complete each step
          </div>
        </div>

        {# Trust Badges #}
        <div class="mi-trust-badges">
          <h4 class="mi-trust-title">Shop with Confidence</h4>
          <div class="mi-trust-list">
            
            <div class="mi-trust-item">
              <div class="mi-trust-icon-wrap">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              </div>
