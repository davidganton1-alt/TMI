{{ header }}

<div class="mi-container mi-section">
  <div style="max-width: 1000px; margin: 0 auto;">

    {# ── Breadcrumbs ── #}
    <ul class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
      <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ul>

    {# ── Welcome Header ── #}
    <div style="padding: 24px 0 32px; border-bottom: 1px solid var(--mi-border-subtle); margin-bottom: 32px;">
      <h1 class="mi-h2" style="margin-bottom: 8px;">Hello, {{ name }}!</h1>
      <p style="color: var(--mi-text-secondary); font-size: var(--mi-fs-md); margin: 0;">
        Welcome back to your account dashboard. Manage your orders, escrow protection, and settings below.
      </p>
    </div>

    {# ── Account Grid ── #}
    <div class="mi-account-grid">
      
      {# Order History #}
      <a href="{{ order }}" class="mi-account-card">
        <div class="mi-account-card__icon" style="background: var(--mi-color-primary-soft); color: var(--mi-color-primary);">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </div>
        <div class="mi-account-card__body">
          <h3>Order History</h3>
          <p>View your past orders, tracking numbers, and invoices.</p>
        </div>
      </a>

      {# Escrow Center (NEW) #}
      <a href="index.php?route=extension/module/mi_escrow/center" class="mi-account-card">
        <div class="mi-account-card__icon" style="background: var(--mi-color-success-soft); color: var(--mi-color-success);">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
        </div>
        <div class="mi-account-card__body">
          <h3>Escrow Center</h3>
          <p>Manage your 20-day on-chain escrow protection and disputes.</p>
        </div>
      </a>

      {# Downloads #}
      <a href="{{ download }}" class="mi-account-card">
        <div class="mi-account-card__icon" style="background: #F3E8FF; color: #9333EA;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </div>
        <div class="mi-account-card__body">
          <h3>Downloads</h3>
          <p>Access your purchased digital products and files.</p>
        </div>
      </a>

      {# Recurring Payments #}
      {% if recurring %}
      <a href="{{ recurring }}" class="mi-account-card">
        <div class="mi-account-card__icon" style="background: #FEF3C7; color: #D97706;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
        </div>
        <div class="mi-account-card__body">
          <h3>Recurring Payments</h3>
          <p>Manage your active subscriptions and recurring profiles.</p>
        </div>
      </a>
      {% endif %}

      {# Reward Points #}
      {% if reward %}
      <a href="{{ reward }}" class="mi-account-card">
        <div class="mi-account-card__icon" style="background: #FFEDD5; color: #EA580C;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <div class="mi-account-card__body">
          <h3>Reward Points</h3>
          <p>Check your balance and redeem your loyalty rewards.</p>
        </div>
      </a>
      {% endif %}

      {# Returns #}
      <a href="{{ return }}" class="mi-account-card">
        <div class="mi-account-card__icon" style="background: #FEE2E2; color: #DC2626;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
        </div>
        <div class="mi-account-card__body">
          <h3>Returns</h3>
          <p>Track your product returns and replacement requests.</p>
        </div>
      </a>

      {# Transactions #}
      {% if transaction %}
      <a href="{{ transaction }}" class="mi-account-card">
        <div class="mi-account-card__icon" style="background: #E0F2FE; color: #0284C7;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        </div>
        <div class="mi-account-card__body">
          <h3>Transactions</h3>
          <p>View your account balance and transaction history.</p>
        </div>
      </a>
      {% endif %}

      {# Newsletter #}
      <a href="{{ newsletter }}" class="mi-account-card">
        <div class="mi-account-card__icon" style="background: #F1F5F9; color: #475569;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <div class="mi-account-card__body">
          <h3>Newsletter</h3>
          <p>Update your email subscription preferences.</p>
        </div>
      </a>

      {# Address Book #}
      <a href="{{ address }}" class="mi-account-card">
        <div class="mi-account-card__icon" style="background: #F1F5F9; color: #475569;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <div class="mi-account-card__body">
          <h3>Address Book</h3>
          <p>Edit your billing and shipping addresses.</p>
        </div>
      </a>

      {# Edit Account #}
      <a href="{{ edit }}" class="mi-account-card">
        <div class="mi-account-card__icon" style="background: #F1F5F9; color: #475569;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        </div>
        <div class="mi-account-card__body">
          <h3>Edit Account</h3>
          <p>Update your personal details and contact information.</p>
        </div>
      </a>

      {# Password #}
      <a href="{{ password }}" class="mi-account-card">
        <div class="mi-account-card__icon" style="background: #F1F5F9; color: #475569;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <div class="mi-account-card__body">
          <h3>Password</h3>
          <p>Change your account password for security.</p>
        </div>
      </a>

      {# Wishlist #}
      <a href="{{ wishlist }}" class="mi-account-card">
        <div class="mi-account-card__icon" style="background: #F1F5F9; color: #475569;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </div>
        <div class="mi-account-card__body">
          <h3>Wishlist</h3>
          <p>View the products you have saved for later.</p>
        </div>
      </a>

      {# Logout #}
      <a href="{{ logout }}" class="mi-account-card" style="border-color: var(--mi-border-defined);">
        <div class="mi-account-card__icon" style="background: #FEF2F2; color: #DC2626;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </div>
        <div class="mi-account-card__body">
          <h3>Logout</h3>
          <p>Sign out of your account securely.</p>
        </div>
      </a>

    </div>
  </div>
</div>

<style>
.mi-account-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 20px;
}
.mi-account-card {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  background: var(--mi-bg-card);
  border: 1px solid var(--mi-border-subtle);
  border-radius: var(--mi-radius-lg);
  padding: 20px;
  text-decoration: none;
  transition: all 0.2s ease;
  box-shadow: var(--mi-shadow-sm);
}
.mi-account-card:hover {
  transform: translateY(-2px);
  border-color: var(--mi-border-defined);
  box-shadow: var(--mi-shadow-md);
  text-decoration: none;
}
.mi-account-card__icon {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: var(--mi-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}
.mi-account-card__icon svg {
  width: 22px;
  height: 22px;
}
.mi-account-card__body h3 {
  margin: 0 0 4px 0;
  font-size: var(--mi-fs-sm);
  font-weight: var(--mi-fw-bold);
  color: var(--mi-text-headline);
}
.mi-account-card__body p {
  margin: 0;
  font-size: 13px;
  color: var(--mi-text-secondary);
  line-height: 1.4;
}
@media (max-width: 600px) {
  .mi-account-grid {
    grid-template-columns: 1fr;
  }
}
</style>

{{ footer }}